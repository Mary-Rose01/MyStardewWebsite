@page "/characters"
@rendermode InteractiveServer
@using MyWebsite.Models
@using MyWebsite.Services
@inject CharacterDataService CharacterData
@inject QuizStateService QuizState

<div class="stardew-bg-fixed"></div>

<div class="stardew-page-container">
    <!-- Header Banner -->
    <div class="stardew-banner-header">
        <h1 class="stardew-banner-title">Pelican Town Villagers</h1>
        <p class="stardew-banner-subtitle">
            @if (QuizState.HasCompletedQuiz && QuizState.MatchedCharacter != null)
            {
                <span class="text-emerald-800 font-bold">★ Full dossiers unlocked! Your match: @QuizState.MatchedCharacter.Name ★</span>
            }
            else
            {
                <span>Complete the quiz to unlock complete bios and secret preferences!</span>
            }
        </p>
    </div>

    @if (characters == null || !characters.Any())
    {
        <div class="bg-[#f7dfa5]/90 border-2 border-amber-900 px-6 py-4 rounded text-amber-950 font-semibold">
            Loading villagers...
        </div>
    }
    else
    {
        <!-- Bachelors -->
        <section class="w-full max-w-6xl mb-12">
            <div class="stardew-section-badge">
                <h2 class="text-lg md:text-xl font-bold text-amber-950 tracking-wide">Bachelors</h2>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                @foreach (var bachelor in bachelors) { @RenderCharacterCard(bachelor) }
            </div>
        </section>

        <!-- Bachelorettes -->
        <section class="w-full max-w-6xl pb-12">
            <div class="stardew-section-badge">
                <h2 class="text-lg md:text-xl font-bold text-amber-950 tracking-wide">Bachelorettes</h2>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                @foreach (var bachelorette in bachelorettes) { @RenderCharacterCard(bachelorette) }
            </div>
        </section>
    }
</div>

@code {
    private List<Character> characters = new();
    private List<Character> bachelors = new();
    private List<Character> bachelorettes = new();

    private readonly HashSet<string> bachelorNames = new(StringComparer.OrdinalIgnoreCase)
    {
        "Sebastian", "Shane", "Elliott", "Harvey", "Sam", "Alex"
    };

    protected override void OnInitialized()
    {
        characters = CharacterData.GetAllCharacters();
        bachelors = characters.Where(c => bachelorNames.Contains(c.Name)).ToList();
        bachelorettes = characters.Where(c => !bachelorNames.Contains(c.Name)).ToList();
    }

    private RenderFragment RenderCharacterCard(Character villager) => __builder =>
    {
        bool isBestFriend = QuizState.HasCompletedQuiz && QuizState.MatchedCharacter?.Id == villager.Id;

        <div class="@(isBestFriend ? "stardew-card-bestfriend" : "stardew-card")">
            @if (isBestFriend)
            {
                <div class="absolute -top-3 right-4 bg-emerald-600 text-amber-100 text-xs font-bold px-3 py-1 rounded-full border border-emerald-900 shadow">
                    Best Friend Match
                </div>
            }

            <div>
                <div class="flex items-center gap-4 mb-4 pb-3 border-b-2 border-amber-900/20">
                    <div class="stardew-avatar-box">
                        <img src="@villager.ImageUrl" alt="@villager.Name" class="w-full h-full object-cover [image-rendering:pixelated]" />
                    </div>
                    <div>
                        <h3 class="text-xl font-bold text-amber-950">@villager.Name</h3>
                        <p class="text-xs text-amber-900/80 font-medium">🎂 Birthday: @villager.Birthday</p>
                        <p class="text-xs text-amber-900/80 font-medium">🍂 Fav Season: @villager.FavoriteSeason</p>
                    </div>
                </div>

                <div class="text-sm text-amber-950/90 leading-relaxed space-y-2">
                    @if (!QuizState.HasCompletedQuiz)
                    {
                        <p class="italic">"@villager.ShortDescription"</p>
                        <p class="text-xs pt-1"><strong class="text-amber-950">Loved Gift:</strong> @villager.FavoriteGift</p>
                    }
                    else
                    {
                        <p class="text-xs md:text-sm font-normal">@villager.DetailedDescription</p>
                        <div class="pt-2 text-xs space-y-1 border-t border-amber-900/10">
                            <p><strong class="text-amber-950">Favorite Food:</strong> @villager.FavoriteFood</p>
                            <p><strong class="text-amber-950">Loved Gifts:</strong> @villager.FavoriteGift</p>
                            @if (villager.Hobbies.Any())
                            {
                                <p><strong class="text-amber-950">Hobbies:</strong> @string.Join(", ", villager.Hobbies)</p>
                            }
                            @if (villager.Family.Any())
                            {
                                <p><strong class="text-amber-950">Family:</strong> @string.Join(", ", villager.Family)</p>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    };
}