@page "/"
@rendermode InteractiveServer
@inject NavigationManager Nav

<div class="stardew-bg-fixed"></div>

<div class="stardew-home-container">
    <!-- HERO SECTION -->
    <div class="flex flex-row items-center gap-8 lg:gap-10">
        <div class="flex flex-col items-start gap-5 lg:w-7/12">
            <h1 class="stardew-hero-title">Which Stardew Character Is For You?</h1>
            <p class="stardew-hero-desc">
                Find out more about the NPCs in Stardew Valley and discover which character is available and best suited to live with you in your farm.
            </p>
            <div class="flex flex-row flex-wrap items-center gap-4 pt-1">
                <button @onclick="StartQuiz" class="stardew-btn-primary">Answer Now</button>
                <button @onclick="NavigateToCharacters" class="stardew-btn-secondary">Learn More</button>
            </div>
        </div>

        <div class="flex w-full justify-center lg:w-5/12 lg:justify-end">
            <img src="/images/stardew_farm.png" alt="Stardew Valley farm" class="h-auto w-full max-w-md stardew-pixel-img lg:max-w-none" />
        </div>
    </div>

    <!-- POPULAR RESIDENTS -->
    <div class="flex flex-col items-center gap-6">
        <div class="flex justify-center">
            <img src="/images/popular-bachelors-and-bachelorettes.png" alt="Popular Bachelors and Bachelorettes"
                 class="h-auto w-full max-w-xs stardew-pixel-img sm:max-w-md lg:max-w-[570px]" />
        </div>

        <div class="flex w-full flex-row flex-wrap justify-center">
            <div class="flex w-1/2 flex-col items-center p-2 lg:w-1/4 lg:p-4">
                <img src="/images/sebastian_portrait.png" alt="Sebastian" class="aspect-square w-full stardew-pixel-img" />
                <img src="/images/sebastian_label.png" alt="Sebastian" class="-mt-1 h-auto w-3/4 stardew-pixel-img" />
            </div>
            <div class="flex w-1/2 flex-col items-center p-2 lg:w-1/4 lg:p-4">
                <img src="/images/abigail_portrait.png" alt="Abigail" class="aspect-square w-full stardew-pixel-img" />
                <img src="/images/abigail_scroll.png" alt="Abigail" class="-mt-1 h-auto w-3/4 stardew-pixel-img" />
            </div>
            <div class="flex w-1/2 flex-col items-center p-2 lg:w-1/4 lg:p-4">
                <img src="/images/haley_portrait.png" alt="Haley" class="aspect-square w-full stardew-pixel-img" />
                <img src="/images/haley_label.png" alt="Haley" class="-mt-1 h-auto w-3/4 stardew-pixel-img" />
            </div>
            <div class="flex w-1/2 flex-col items-center p-2 lg:w-1/4 lg:p-4">
                <img src="/images/penny_portrait.png" alt="Penny" class="aspect-square w-full stardew-pixel-img" />
                <img src="/images/penny_label.png" alt="Penny" class="-mt-1 h-auto w-3/4 stardew-pixel-img" />
            </div>
        </div>
    </div>
</div>

@code {
    private void StartQuiz() => Nav.NavigateTo("/quiz");
    private void NavigateToCharacters() => Nav.NavigateTo("/characters");
}